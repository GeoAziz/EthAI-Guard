# Environment examples for EthixAI
# Copy this file to .env and fill in the PLACEHOLDER values with actual secrets

# ============ DATABASE CONFIGURATION ============

# MongoDB connection (used by backend and ai_core)
MONGO_URL=mongodb://mongo:27017/ethixai

# PostgreSQL - used for row-level-security-enforced multi-tenant billing data
# (backend/migrations/postgres/0001_tenancy_billing.sql). POSTGRES_URL is the
# superuser/table-owner connection, used only for running migrations
# (scripts/migrate_postgres.js) and role provisioning (scripts/setup_postgres_role.js).
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/ethixai

# Non-superuser role that FORCE ROW LEVEL SECURITY actually restricts. The
# backend (backend/src/db/postgres.js) connects as this role so tenant
# isolation is enforced rather than bypassed. Provisioned automatically by
# backend/migrations/postgres-init/00-provision-app-role.sh on first
# `docker compose up`, or manually via `node scripts/setup_postgres_role.js`.
POSTGRES_APP_USER=ethixai_app
POSTGRES_APP_PASSWORD=change-me-app-role-password
POSTGRES_APP_URL=postgresql://ethixai_app:change-me-app-role-password@postgres:5432/ethixai

# Redis (cache + pub/sub backbone for real-time streaming). Omit to fall back
# to an in-memory cache and in-process event bus (single instance only).
REDIS_URL=redis://redis:6379

# ============ AUTHENTICATION & SECURITY ============

# JWT secrets (replace before production)
SECRET_KEY=sk_PLACEHOLDER_REPLACE_WITH_STRONG_SECRET_32_CHARS_MIN
REFRESH_SECRET=rf_PLACEHOLDER_REPLACE_WITH_REFRESH_SECRET_32_CHARS_MIN
SESSION_SECRET=ss_PLACEHOLDER_REPLACE_WITH_SESSION_SECRET_32_CHARS_MIN

# Firebase Admin SDK (optional - for production auth)
# DO NOT commit serviceAccountKey.json to git - keep in secure storage
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Auth provider: 'firebase' or 'none' (demo)
AUTH_PROVIDER=none

# ============ PAYMENT PROCESSING (STRIPE) ============
# Sign up for Stripe at https://stripe.com
# Get test keys from Stripe Dashboard → Developers → API Keys
# Replace PLACEHOLDER values with actual keys

# Stripe Secret Key (test or live)
# Test: sk_test_*****
# Production: sk_live_*****
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER_YOUR_STRIPE_SECRET_KEY_HERE

# Stripe Publishable Key (test or live) - used in frontend
# Test: pk_test_*****
# Production: pk_live_*****
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# Stripe Webhook Secret (get from Stripe Dashboard → Webhooks)
# Used to verify webhook signatures
# Format: whsec_*****
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER_YOUR_WEBHOOK_SECRET_HERE

# ============ AWS S3 CONFIGURATION ============
# For storing compliance reports and audit logs
# Optional - if not set, reports are stored in database only

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=PLACEHOLDER_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=ethixai-compliance-reports-PLACEHOLDER_YOUR_BUCKET_NAME

# ============ AI CORE CONFIGURATION ============

# AI core endpoint (backend forwards analysis requests here)
AI_CORE_URL=http://ai_core:8100/ai_core/analyze

# Shared secret required by ai_core's /federated/* routes (see
# ai_core/routers/federated.py#verify_service_token). Must match on both the
# backend (sends it via X-Service-Token, see backend/src/routes/federated.js)
# and ai_core. Required in production; ai_core refuses to start without it
# when ENVIRONMENT=production.
AI_CORE_SERVICE_TOKEN=PLACEHOLDER_SHARED_SERVICE_TOKEN_MIN_32_CHARS

# ============ FRONTEND CONFIGURATION ============

NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# WebSocket endpoint path for real-time analysis/metric streaming
WS_PATH=/ws

# ============ EMAIL SERVICE CONFIGURATION ============

EMAIL_PROVIDER=sendgrid  # Options: 'sendgrid', 'smtp', 'console'
EMAIL_FROM=noreply@ethixai.com
EMAIL_FROM_NAME=EthixAI

# SendGrid (recommended)
# Sign up at https://sendgrid.com and get API key
SENDGRID_API_KEY=SG.PLACEHOLDER_YOUR_SENDGRID_API_KEY

# SMTP (alternative to SendGrid)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=send@example.com
# SMTP_PASS=PLACEHOLDER_YOUR_SMTP_PASSWORD

# Email feature flags
DISABLE_EMAIL_SEND=0  # Set to 1 to disable email sending in development

# ============ SSO & OAUTH CONFIGURATION ============

# SAML SSO (optional - for enterprise customers)
# SAML_ENABLED=false
# SAML_ENTRY_POINT=https://your-sso-provider.com/sso
# SAML_CERTIFICATE=PLACEHOLDER_YOUR_SAML_CERTIFICATE

# Azure AD / Office 365 (optional)
# AZURE_CLIENT_ID=PLACEHOLDER_YOUR_AZURE_CLIENT_ID
# AZURE_CLIENT_SECRET=PLACEHOLDER_YOUR_AZURE_CLIENT_SECRET
# AZURE_TENANT_ID=PLACEHOLDER_YOUR_AZURE_TENANT_ID

# Okta (optional)
# OKTA_ORG_URL=https://your-org.okta.com
# OKTA_CLIENT_ID=PLACEHOLDER_YOUR_OKTA_CLIENT_ID
# OKTA_CLIENT_SECRET=PLACEHOLDER_YOUR_OKTA_CLIENT_SECRET

# ============ OBSERVABILITY & MONITORING ============

# Slack webhook for Alertmanager notifications
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Sentry (error tracking - optional)
# SENTRY_DSN=https://PLACEHOLDER_YOUR_SENTRY_DSN

# DataDog (APM - optional)
# DATADOG_API_KEY=PLACEHOLDER_YOUR_DATADOG_API_KEY

# ============ SERVER CONFIGURATION ============

# Server runtime
NODE_ENV=development
PORT=5000

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ============ DEVELOPMENT OVERRIDES ============

# Optional local dev overrides
# USE_IN_MEMORY_DB=1  # set to 1 to run backend in-memory for tests
# DISABLE_RATE_LIMIT=1  # set to 1 to disable rate limiting in development
